    "D = optim.generateDiff3D(V, F, 'gradient')\n",
    "L = optim.generateDiff3D(V, F, 'laplacien')\n",
    "\n",
    "# attache aux données\n",
    "def f(x):\n",
    "    return np.sum((x - VB)**2)\n",
    "\n",
    "# régularisation\n",
    "def R(x):\n",
    "    return np.sum(x**2)\n",
    "\n",
    "def RD(x):\n",
    "    return np.sum(D@x**2)\n",
    "\n",
    "def RL(x):\n",
    "    return np.sum(L@x**2)\n",
    "\n",
    "# fonction de coût globale\n",
    "def E(x,lam):\n",
    "    return f(x) + lam * RD(x)\n",
    "\n",
    "# # opérateur proximal de la norme l1\n",
    "# def prox_l1(x, gamma, lam):\n",
    "#     return np.sign(x) * np.maximum(np.abs(x) - gamma*lam, 0.0)\n",
    "\n",
    "# def prox_l2(x, gamma):\n",
    "#     return x / (1 + 2*gamma)\n",
    "\n",
    "# def prox_f(x, gamma, lam):\n",
    "#     \"\"\"\n",
    "#     Proximal de f(x) = x^2 + lam |x|\n",
    "#     \"\"\"\n",
    "#     y = prox_l2(x, gamma)\n",
    "#     return prox_l1(y, gamma, lam)\n",
    "\n",
    "\n",
    "def prox_tv_mesh(v, D, lam, gamma, n_iter=50):\n",
    "    \"\"\"\n",
    "    Proximal de g(x) = lam * ||D x||_1\n",
    "    sur maillage 3D\n",
    "    \"\"\"\n",
    "    p = np.zeros_like(D @ v)\n",
    "    tau = 0.125  # stable en général\n",
    "\n",
    "    for _ in range(n_iter):\n",
    "        Dv = D @ (v - gamma * lam * D.T @ p)\n",
    "        p = p + tau * Dv\n",
    "        p = p / np.maximum(1, np.abs(p))  # projection L∞\n",
    "\n",
    "    return v - gamma * lam * D.T @ p\n"
   ]
